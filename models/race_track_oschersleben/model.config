<?xml version="1.0"?>
<model>
  <name>race_track_oschersleben</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Yashom Dighe (audubon_gazebo, mesh)</name>
  </author>
  <description>
    Oschersleben track from audubon_gazebo (F1TENTH scale, ~2 m lane), scaled x5 in
    XY so the full-size audi_r8 fits (~10 m lane); height scaled to 0.5 m walls
    so the drone sees the car over them. The mesh is a
    slab with the lane cut out; cars drive on the world's ground plane.
    The mesh sits below z=0, so the world pose lifts its base onto the ground.
  </description>
</model>
