<?xml version="1.0"?>
<sdf version="1.6">
    <model name="car_polo">
        <enable_wind>1</enable_wind>
        <static>0</static>

        <!-- ============================================================
             MAIN BODY
             Approx real-world VW Polo dimensions used below:
             length 4.05 m, width 1.68 m, height 1.45 m, mass ~1130 kg,
             wheelbase 2.55 m, track width ~1.43 m, wheel radius 0.316 m.
             Polo.dae was authored in SketchUp with unit="inch", hence the
             0.0254 mesh scale. Check the mesh's orientation/origin once
             loaded in Gazebo, you may need to tweak base_link_visual's
             <pose> (especially yaw, if the car appears to face backwards)
             and the mesh scale if it doesn't align with the collision box.
             ============================================================ -->
        <link name="base_link">
            <inertial>
                <pose>0 0 0.6 0 0 0</pose>
                <mass>1130</mass>
                <inertia>
                    <ixx>463.8</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1742.6</iyy>
                    <iyz>0</iyz>
                    <izz>1810.3</izz>
                </inertia>
            </inertial>

            <collision name="base_link_collision">
                <pose>0 0 0.6 0 0 0</pose>
                <geometry>
                    <box>
                        <size>4.05 1.68 1.2</size>
                    </box>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.8</mu>
                            <mu2>0.8</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>

            <visual name="base_link_visual">
                <!-- Corrective yaw so the mesh's visual "front" lines up with
                     the chassis's local +x axis, which is what DiffDrive
                     treats as forward. Physics/wheel motion was already
                     correct; this only fixes what direction the mesh
                     LOOKS like it's facing. If it's still not lined up
                     after respawning, try -1.5707963267948966 (i.e. the
                     opposite sign), or 3.14159 (180 deg), instead.  -->
                <pose>0 0 0 0 0 1.5707963267948966</pose>
                <geometry>
                    <mesh>
                        <uri>model://car_polo/meshes/Polo.dae</uri>
                        <scale>0.0254 0.0254 0.0254</scale>
                    </mesh>
                </geometry>
            </visual>

            <!-- ========================================================
                 ARUCO / LANDING-TARGET MARKER
                 Same pattern as X1's marker_visual_* links (a dedicated
                 mesh file in meshes/, not an SDF material script). This
                 mesh is a flat 0.8m x 0.8m quad with LandingTargetTemplate.png
                 baked in as its diffuse texture, facing straight up (+z),
                 mounted on the roof. Raise/lower the pose's Z if it clips
                 into or floats above the roof mesh once you check
                 alignment in Gazebo.
                 ======================================================== -->
            <visual name="aruco_marker_visual">
                <pose>-1.8 0.6 1.03 0 0 -1.5707963267948966</pose>
                <geometry>
                    <mesh>
                        <uri>model://car_polo/meshes/LandingTargetTemplate.dae</uri>
                        <scale>1.2 1.2 1.2</scale> 
                    </mesh>
                </geometry>
                <cast_shadows>false</cast_shadows>
            </visual>
        </link>

        <!-- ============================================================
             WHEELS
             ============================================================ -->
        <link name="front_left_wheel">
            <pose>1.275 0.715 0.316 0 0 0</pose>
            <inertial>
                <mass>15</mass>
                <inertia>
                    <ixx>0.4246</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.4246</iyy>
                    <iyz>0</iyz>
                    <izz>0.749</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.316</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="front_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>front_left_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <link name="front_right_wheel">
            <pose>1.275 -0.715 0.316 0 0 0</pose>
            <inertial>
                <mass>15</mass>
                <inertia>
                    <ixx>0.4246</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.4246</iyy>
                    <iyz>0</iyz>
                    <izz>0.749</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.316</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="front_right_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>front_right_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <link name="rear_left_wheel">
            <pose>-1.275 0.715 0.316 0 0 0</pose>
            <inertial>
                <mass>15</mass>
                <inertia>
                    <ixx>0.4246</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.4246</iyy>
                    <iyz>0</iyz>
                    <izz>0.749</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.316</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="rear_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>rear_left_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <link name="rear_right_wheel">
            <pose>-1.275 -0.715 0.316 0 0 0</pose>
            <inertial>
                <mass>15</mass>
                <inertia>
                    <ixx>0.4246</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.4246</iyy>
                    <iyz>0</iyz>
                    <izz>0.749</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.316</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="rear_right_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>rear_right_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <!-- ============================================================
             DRIVE + ODOMETRY PLUGINS
             Publish geometry_msgs-style Twist messages on /model/car_polo/cmd_vel
             to drive the car, e.g.:
             gz topic pub -t /model/car_polo/cmd_vel -m gz.msgs.Twist \
               -p "linear: {x: 1.0}, angular: {z: 0.3}"
             ============================================================ -->
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <wheel_separation>1.43</wheel_separation>
            <wheel_radius>0.316</wheel_radius>
            <odom_publish_frequency>20</odom_publish_frequency>
            <topic>cmd_vel</topic>
        </plugin>
        <plugin
            name="gz::sim::systems::OdometryPublisher"
            filename="gz-sim-odometry-publisher-system">
            <topic>/model/car_polo/odometry</topic>
            <odom_frame_id>car_polo/odom</odom_frame_id>
            <child_frame_id>car_polo/base_link</child_frame_id>
            <world_frame>true</world_frame>
            <publish_odom>true</publish_odom>
        </plugin>
    </model>
</sdf>
