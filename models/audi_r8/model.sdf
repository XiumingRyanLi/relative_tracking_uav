<?xml version="1.0"?>
<sdf version="1.6">
    <model name="audi_r8">
        <enable_wind>1</enable_wind>
        <static>0</static>

        <!-- ============================================================
             MAIN BODY
             Mesh: meshes/audi_r8.dae is a ~300k-face decimation of
             ~/data/models/Audi_R8/audi_r8.obj (14.9M faces), which is the
             exact mesh used to render the DOPE "Audi" training data. The
             original is authored in metres with y-up; on export it was
             rotated to z-up with the car's length along +x, so the visual
             pose below is identity and no <scale> is needed.
             Mesh extents (m): 4.415 long (x), 2.038 wide (y), 1.240 high
             (z, from ground). These match the DOPE cuboid dimensions
             [203.82, 123.95, 441.46] cm used by dope_detector.
             Approx real-world Audi R8: mass ~1600 kg, wheelbase 2.65 m,
             track ~1.64 m, wheel radius ~0.335 m.
             ============================================================ -->
        <link name="base_link">
            <inertial>
                <pose>0 0 0.6 0 0 0</pose>
                <mass>1600</mass>
                <inertia>
                    <ixx>739</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>2786</iyy>
                    <iyz>0</iyz>
                    <izz>3114</izz>
                </inertia>
            </inertial>

            <!-- Box starts 0.25 m above ground so only the wheels contact
                 the ground plane. -->
            <collision name="base_link_collision">
                <pose>0 0 0.75 0 0 0</pose>
                <geometry>
                    <box>
                        <size>4.41 2.04 1.0</size>
                    </box>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.8</mu>
                            <mu2>0.8</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>

            <visual name="base_link_visual">
                <!-- The exported mesh has its nose along -x (checked with a
                     Blender preview render), so yaw by 180 deg to put the
                     nose along +x, which DiffDrive treats as forward. -->
                <pose>0 0 0 0 0 3.14159265358979</pose>
                <geometry>
                    <mesh>
                        <uri>model://audi_r8/meshes/audi_r8.dae</uri>
                    </mesh>
                </geometry>
            </visual>

            <!-- ========================================================
                 APRILTAG / LANDING-TARGET MARKER (same as car_polo)
                 0.067 m tag scaled 6x = 0.402 m, flat, facing +z, on the
                 roof (mesh roof peak is z=1.24). Remove this visual if you
                 want the car to look exactly like the DOPE training renders.
                 ======================================================== -->
            <visual name="aruco_marker_visual">
                <pose>-0.1 0 1.245 0 0 -1.5707963267948966</pose>
                <geometry>
                    <mesh>
                        <uri>model://audi_r8/meshes/april_tag.dae</uri>
                        <scale>6 6 1</scale>
                    </mesh>
                </geometry>
                <cast_shadows>false</cast_shadows>
            </visual>
        </link>
        <link name="front_left_wheel">
            <pose>1.325 0.82 0.335 0 0 0</pose>
            <inertial>
                <mass>18</mass>
                <inertia>
                    <ixx>0.6</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.6</iyy>
                    <iyz>0</iyz>
                    <izz>1.01</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.335</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="front_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>front_left_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <link name="front_right_wheel">
            <pose>1.325 -0.82 0.335 0 0 0</pose>
            <inertial>
                <mass>18</mass>
                <inertia>
                    <ixx>0.6</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.6</iyy>
                    <iyz>0</iyz>
                    <izz>1.01</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.335</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="front_right_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>front_right_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <link name="rear_left_wheel">
            <pose>-1.325 0.82 0.335 0 0 0</pose>
            <inertial>
                <mass>18</mass>
                <inertia>
                    <ixx>0.6</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.6</iyy>
                    <iyz>0</iyz>
                    <izz>1.01</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.335</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="rear_left_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>rear_left_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <link name="rear_right_wheel">
            <pose>-1.325 -0.82 0.335 0 0 0</pose>
            <inertial>
                <mass>18</mass>
                <inertia>
                    <ixx>0.6</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.6</iyy>
                    <iyz>0</iyz>
                    <izz>1.01</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <pose>0 0 0 -1.5707963267948966 0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.2</length>
                        <radius>0.335</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>1</mu2>
                            <slip1>0.00062</slip1>
                            <slip2>0</slip2>
                            <fdir1>0 0 1</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
        <joint name="rear_right_wheel_joint" type="revolute">
            <parent>base_link</parent>
            <child>rear_right_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>+1.79769e+308</upper>
                </limit>
            </axis>
        </joint>

        <!-- ============================================================
             DRIVE + ODOMETRY PLUGINS
             DiffDrive's <topic>cmd_vel</topic> is NOT model-scoped: the car
             listens on the bare /cmd_vel gz topic (verified). Drive it with:
             gz topic -t /cmd_vel -m gz.msgs.Twist \
               -p "linear: {x: 2.0}, angular: {z: 0.3}"
             Ground truth comes from OdometryPublisher on its default topic
             /model/<world model name>/odometry, i.e.
             /model/LandingVehicle/odometry with iris_runway_new.sdf: the
             true world pose. DiffDrive also defaults to that topic, but its
             odometry is wheel dead-reckoning from (0,0) facing +x, so it is
             moved to /audi_r8/wheel_odometry -- two publishers on one topic
             made the logged truth jump between two different poses.
             ============================================================ -->
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <wheel_separation>1.64</wheel_separation>
            <wheel_radius>0.335</wheel_radius>
            <odom_publish_frequency>20</odom_publish_frequency>
            <odom_topic>/audi_r8/wheel_odometry</odom_topic>
            <topic>cmd_vel</topic>
        </plugin>
        <plugin
            name="gz::sim::systems::OdometryPublisher"
            filename="gz-sim-odometry-publisher-system">
            <odom_frame>world</odom_frame>
            <robot_base_frame>audi_r8/base_link</robot_base_frame>
            <odom_publish_frequency>20</odom_publish_frequency>
            <dimensions>3</dimensions>
        </plugin>
    </model>
</sdf>
