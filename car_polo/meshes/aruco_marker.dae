<?xml version="1.0" encoding="UTF-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
    <asset>
        <contributor>
            <authoring_tool>car_polo model generation</authoring_tool>
        </contributor>
        <unit meter="1.0" name="meter" />
        <up_axis>Z_UP</up_axis>
    </asset>

    <library_images>
        <image id="aruco_texture" name="aruco_texture">
            <init_from>LandingTargetTemplate.png</init_from>
        </image>
    </library_images>

    <library_effects>
        <effect id="aruco_effect">
            <profile_COMMON>
                <newparam sid="aruco_texture_surface">
                    <surface type="2D">
                        <init_from>aruco_texture</init_from>
                    </surface>
                </newparam>
                <newparam sid="aruco_texture_sampler">
                    <sampler2D>
                        <source>aruco_texture_surface</source>
                    </sampler2D>
                </newparam>
                <technique sid="common">
                    <lambert>
                        <diffuse>
                            <texture texture="aruco_texture_sampler" texcoord="UVSET0" />
                        </diffuse>
                        <index_of_refraction>
                            <float>1.0</float>
                        </index_of_refraction>
                    </lambert>
                </technique>
            </profile_COMMON>
        </effect>
    </library_effects>

    <library_materials>
        <material id="aruco_material" name="aruco_material">
            <instance_effect url="#aruco_effect" />
        </material>
    </library_materials>

    <library_geometries>
        <geometry id="aruco_marker_mesh" name="aruco_marker_mesh">
            <mesh>
                <source id="aruco_marker_positions">
                    <float_array id="aruco_marker_positions_array" count="12">
                        -0.4 -0.4 0
                         0.4 -0.4 0
                         0.4  0.4 0
                        -0.4  0.4 0
                    </float_array>
                    <technique_common>
                        <accessor source="#aruco_marker_positions_array" count="4" stride="3">
                            <param name="X" type="float" />
                            <param name="Y" type="float" />
                            <param name="Z" type="float" />
                        </accessor>
                    </technique_common>
                </source>

                <source id="aruco_marker_normals">
                    <float_array id="aruco_marker_normals_array" count="3">
                        0 0 1
                    </float_array>
                    <technique_common>
                        <accessor source="#aruco_marker_normals_array" count="1" stride="3">
                            <param name="X" type="float" />
                            <param name="Y" type="float" />
                            <param name="Z" type="float" />
                        </accessor>
                    </technique_common>
                </source>

                <source id="aruco_marker_uvs">
                    <float_array id="aruco_marker_uvs_array" count="8">
                        0 0
                        1 0
                        1 1
                        0 1
                    </float_array>
                    <technique_common>
                        <accessor source="#aruco_marker_uvs_array" count="4" stride="2">
                            <param name="S" type="float" />
                            <param name="T" type="float" />
                        </accessor>
                    </technique_common>
                </source>

                <vertices id="aruco_marker_vertices">
                    <input semantic="POSITION" source="#aruco_marker_positions" />
                </vertices>

                <triangles material="aruco_material_symbol" count="2">
                    <input semantic="VERTEX" source="#aruco_marker_vertices" offset="0" />
                    <input semantic="NORMAL" source="#aruco_marker_normals" offset="1" />
                    <input semantic="TEXCOORD" source="#aruco_marker_uvs" offset="2" set="0" />
                    <p>0 0 0  1 0 1  2 0 2   0 0 0  2 0 2  3 0 3</p>
                </triangles>
            </mesh>
        </geometry>
    </library_geometries>

    <library_visual_scenes>
        <visual_scene id="aruco_marker_scene" name="aruco_marker_scene">
            <node id="aruco_marker_node" name="aruco_marker_node">
                <instance_geometry url="#aruco_marker_mesh">
                    <bind_material>
                        <technique_common>
                            <instance_material symbol="aruco_material_symbol" target="#aruco_material">
                                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0" />
                            </instance_material>
                        </technique_common>
                    </bind_material>
                </instance_geometry>
            </node>
        </visual_scene>
    </library_visual_scenes>

    <scene>
        <instance_visual_scene url="#aruco_marker_scene" />
    </scene>
</COLLADA>
